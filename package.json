{
  "name": "figma-breakpoint-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "Figma plugin for the Breakpoint dimension of a design system: switch every nested variant and mode of a screen, bind variants to a variable, add the property to components.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs --minify",
    "dev": "node scripts/build.mjs --watch",
    "preview": "node scripts/preview.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:ui-kit": "node scripts/sync-ui-kit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.139.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
